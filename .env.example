# Copy to .env.local for local runs. Set the same names in Vercel > Settings > Environment Variables.
# Fill every value yourself. Never commit the real file.

# The wallet that pays x402 fees on Base Sepolia. A fresh burner funded with testnet USDC from
# https://faucet.circle.com (select Base Sepolia). MetaMask exports the key without a 0x prefix;
# either form is accepted. Use a wallet that is not used by any other project.
PAYER_PRIVATE_KEY=

# Spending guards. Calls per UTC day across all visitors. 0 keeps paid work switched off.
DAILY_CALL_BUDGET=0
# Calls one visitor may trigger per UTC day (a research dossier is 8 calls, a news dossier 3 to 4).
VISITOR_DAILY_CALLS=64
# Highest price per call the app will accept, in USDC. Most miners charge 0.01.
MAX_CALL_PRICE_USDC=0.02
# Set to true to refuse all paid work without redeploying.
PAUSED=false

# Salt for hashing visitor ids before they are stored. Any long random string.
VISITOR_SALT=

# Optional. Upstash Redis (Vercel Marketplace > Upstash) keeps the ledger, dossiers and counters
# across deployments. Without it everything is held in memory and resets on each cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides.
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
# The public URL of this deployment, used for share links.
PUBLIC_URL=
